{
  "name": "scienceboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "check": "pnpm science:data:check && pnpm cf:types:check && pnpm typecheck && pnpm test && pnpm build && pnpm cf:deploy:dry && pnpm cf:deploy:legacy:dry",
    "science:data": "node docs/research/ai-science-discoveries-2026-08-02/build-report-artifact.mjs",
    "science:data:check": "node docs/research/ai-science-discoveries-2026-08-02/build-report-artifact.mjs --check",
    "db:migrate:local": "wrangler d1 migrations apply aimathbase --local",
    "db:migrate:remote": "wrangler d1 migrations apply aimathbase --remote",
    "cf:types": "wrangler types",
    "cf:types:check": "wrangler types --check",
    "cf:dev": "wrangler dev",
    "cf:deploy:dry": "wrangler deploy --dry-run",
    "cf:deploy": "wrangler deploy",
    "cf:deploy:legacy:dry": "wrangler deploy --dry-run --config wrangler.legacy.jsonc",
    "cf:deploy:legacy": "wrangler deploy --config wrangler.legacy.jsonc"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260731.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest",
    "vitest": "latest",
    "wrangler": "4.118.0"
  }
}
